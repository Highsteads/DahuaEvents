<?xml version="1.0" encoding="UTF-8"?>
<!-- Stage 1 declares the device type so the shape is settled and the XML tests have
     something to check. The device factory that creates the person/vehicle pair, and
     the event stream that drives them, arrive in stages 3 and 2 respectively.

     NOTE: onOffState is NOT declared here. It is a NATIVE state on a sensor device,
     inherited when SupportsOnState is set True at creation. Declaring a native state
     makes the Indigo client log "illegal state key ... native state keys cannot be
     overriden (ignoring)" once per device at every startup. -->
<Devices>

    <!-- One dialog per CAMERA creates the Person and Vehicle pair, so the two can
         never be half-configured or inconsistently named. Note that once a
         DeviceFactory exists the sub-devices are no longer individually creatable
         from Indigo's New Device dialog — that is by design here. -->
    <DeviceFactory>
        <Name>Dahua Camera...</Name>
        <ButtonTitle>Close</ButtonTitle>
        <ConfigUI>
            <Field id="factoryLabel" type="label">
                <Label>Adds a camera and creates two sensors for it — one for people, one for vehicles. The camera does the recognition itself; nothing is analysed on this machine.</Label>
            </Field>
            <Field id="cameraName" type="textfield">
                <Label>Camera name:</Label>
                <Description>Devices become "&lt;name&gt; Person" and "&lt;name&gt; Vehicle"</Description>
            </Field>
            <Field id="address" type="textfield">
                <Label>Camera address:</Label>
                <Description>IP address or hostname, e.g. 192.168.1.64</Description>
            </Field>
            <Field id="holdOverride" type="textfield">
                <Label>Hold override (seconds):</Label>
                <Description>Leave blank to use the plugin default</Description>
            </Field>

            <Field id="sepCheck" type="separator"/>
            <Field id="checkCamera" type="button">
                <Label>Not sure what this camera can do?</Label>
                <Title>Check This Camera</Title>
                <CallbackMethod>checkCamera</CallbackMethod>
            </Field>
            <Field id="capabilitySummary" type="textfield" readonly="YES">
                <Label>Camera reports:</Label>
            </Field>

            <Field id="sepClasses" type="separator"/>
            <Field id="classesLabel" type="label">
                <Label>Which detections should this camera provide? People and vehicles need Smart Motion Detection, which most cameras from about 2022 onward have. Tripwire and intrusion are the older generation's equivalent and need a line or zone drawn in the camera's own web interface before they report anything.</Label>
            </Field>
            <Field id="want_person" type="checkbox" defaultValue="true">
                <Label>People</Label>
            </Field>
            <Field id="want_vehicle" type="checkbox" defaultValue="true">
                <Label>Vehicles</Label>
            </Field>
            <Field id="want_crossline" type="checkbox" defaultValue="false">
                <Label>Tripwire (line crossed)</Label>
            </Field>
            <Field id="want_crossregion" type="checkbox" defaultValue="false">
                <Label>Intrusion (zone entered)</Label>
            </Field>
        </ConfigUI>
    </DeviceFactory>

    <Device type="sensor" id="dahuaDetection" subType="Detection">
        <Name>Dahua Detection Sensor</Name>
        <ConfigUI>
            <Field id="address" type="textfield">
                <Label>Camera address:</Label>
                <Description>IP address or hostname, e.g. 192.168.1.64</Description>
            </Field>
            <Field id="detectionClass" type="menu" defaultValue="person">
                <Label>Detects:</Label>
                <List>
                    <Option value="person">People</Option>
                    <Option value="vehicle">Vehicles</Option>
                    <Option value="crossline">Tripwire (line crossed)</Option>
                    <Option value="crossregion">Intrusion (zone entered)</Option>
                </List>
            </Field>
            <Field id="holdOverride" type="textfield">
                <Label>Hold override (seconds):</Label>
                <Description>Leave blank to use the plugin default</Description>
            </Field>
        </ConfigUI>
        <States>
            <State id="lastDetection">
                <ValueType>String</ValueType>
                <TriggerLabel>Last detection</TriggerLabel>
                <ControlPageLabel>Last detection</ControlPageLabel>
            </State>
            <State id="detectionsToday">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Detections today</TriggerLabel>
                <ControlPageLabel>Detections today</ControlPageLabel>
            </State>
            <State id="lastDetectionDay">
                <ValueType>String</ValueType>
                <TriggerLabel>Last detection day</TriggerLabel>
                <ControlPageLabel>Last detection day</ControlPageLabel>
            </State>
            <State id="streamState">
                <ValueType>
                    <List>
                        <Option value="connected">Connected</Option>
                        <Option value="reconnecting">Reconnecting</Option>
                        <Option value="unsupported">Unsupported</Option>
                        <Option value="no rule">No rule drawn on the camera</Option>
                        <Option value="disabled">Disabled on camera</Option>
                    </List>
                </ValueType>
                <TriggerLabel>Stream state</TriggerLabel>
                <ControlPageLabel>Stream state</ControlPageLabel>
            </State>
        </States>
    </Device>

</Devices>
